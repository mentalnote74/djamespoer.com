{
  "name": "djamespoer",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/buildometer/project.mjs && node scripts/deployment-history/build-refresh.mjs && node scripts/generate-build-info.mjs && node scripts/discoverability.mjs",
    "buildometer:observe": "node scripts/buildometer/project.mjs observe",
    "build": "ng build",
    "assets:creative": "node scripts/optimize-creative.mjs",
    "history:refresh": "node scripts/generate-deployment-history.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "evidence:themes": "node scripts/theme-evidence.mjs",
    "test:thingamajob": "node --test server/thingamajob/*.test.mjs",
    "check:thingamajob": "tsc -p server/thingamajob/tsconfig.json",
    "build:production": "node scripts/deployment-history/production-refresh.mjs && npm run build",
    "deploy:production": "npm run build:production && wrangler deploy",
    "postbuild": "node scripts/prepare-public-render.mjs && node scripts/scrum-brief/bind-runtime-secret.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "22.2.1",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "22.2.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@lucide/angular": "^1.59.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "axe-core": "4.14.0",
    "jose": "6.2.12",
    "jsdom": "^30.0.0",
    "lighthouse": "13.5.0",
    "particles.js": "^2.0.0",
    "prettier": "^3.8.1",
    "puppeteer-core": "25.13.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wrangler": "4.150.0"
  }
}
