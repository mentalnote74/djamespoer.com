{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "djamespoer-com",
  "main": "server/buildometer/worker.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "r2_buckets": [{ "binding": "DAILY_REPORTS", "bucket_name": "djamespoer-daily-reports" }],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/djamespoer/browser",
    "binding": "ASSETS",
    "run_worker_first": ["/api/buildometer", "/api/buildometer/reports", "/api/buildometer/reports/*"],
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
  },
}
