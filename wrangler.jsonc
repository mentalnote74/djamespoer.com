{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "djamespoer-com",
  "main": "server/buildometer/worker.ts",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./dist/djamespoer/browser",
    "binding": "ASSETS",
    "run_worker_first": ["/api/buildometer"],
    "not_found_handling": "single-page-application",
  },
}
